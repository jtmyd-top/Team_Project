# Django 环境配置示例
# 复制此文件为 .env 并填写实际值

# ========================================
# 基础配置
# ========================================
DJANGO_ENV=production  # development | production
DEBUG=False  # 生产环境必须设置为 False

# 安全密钥（生产环境必须设置）
# 生成方法: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# 允许的主机（生产环境必须设置）
# 多个主机用逗号分隔，例如: example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF 可信源（生产环境必须设置）
# 多个源用逗号分隔
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1

# ========================================
# 生产环境安全配置
# ========================================
# Cookie 安全（生产环境必须启用）
SESSION_COOKIE_SECURE=True  # 生产环境设置为 True（需要HTTPS）
CSRF_COOKIE_SECURE=True  # 生产环境设置为 True（需要HTTPS）
SESSION_COOKIE_SAMESITE=Lax  # Lax | Strict | None
CSRF_COOKIE_SAMESITE=Lax

# HTTPS 强制重定向（生产环境建议启用）
SECURE_SSL_REDIRECT=True  # 生产环境设置为 True
TRUST_X_FORWARDED_PROTO=True  # 使用反向代理时设置为 True

# HSTS（HTTP严格传输安全）
SECURE_HSTS_SECONDS=31536000  # 生产 HTTPS 环境建议设置为 1 年
SECURE_HSTS_INCLUDE_SUBDOMAINS=False  # 生产环境设置为 True
SECURE_HSTS_PRELOAD=False

# 其他安全头
SECURE_REFERRER_POLICY=same-origin

# ========================================
# 数据库配置
# ========================================
mysql_name=knowledge_project
mysql_user=root
mysql_passwd=your-password
mysql_ip=127.0.0.1
mysql_port=3306

# ========================================
# Redis 配置
# ========================================
REDIS_URL=redis://127.0.0.1:6379/1
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/2

# 缓存异常处理
CACHE_IGNORE_EXCEPTIONS=False  # 生产环境建议设置为 False

# ========================================
# Session 配置
# ========================================
SESSION_ENGINE=django.contrib.sessions.backends.cached_db
SESSION_IDLE_TIMEOUT=10800  # 3小时（秒）
SESSION_ABSOLUTE_TIMEOUT=10800  # 3小时（秒）
SESSION_TOUCH_INTERVAL_SECONDS=300  # 5分钟

# ========================================
# 邮件配置
# ========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_TIMEOUT=30

# 邮件代理（可选）
SMTP_PROXY_HOST=
SMTP_PROXY_PORT=1080
SMTP_PROXY_TYPE=socks5
SMTP_PROXY_USERNAME=
SMTP_PROXY_PASSWORD=
EMAIL_FALLBACK_TO_PROXY=True

# Outlook 备用配置（可选）
OUTLOOK_PASSWORD=

# ========================================
# WebSocket / Channels 配置
# ========================================
REALTIME_MESSAGES_ENABLED=True
REALTIME_MESSAGES_PATH=/ws/messages/
WS_CLIENT_INACTIVITY_TIMEOUT=300  # 5分钟
REQUIRE_SHARED_CHANNEL_LAYER=False  # 生产环境设置为 True

# ========================================
# Web Push / VAPID 配置
# ========================================
# Generate keys with: python manage.py generate_vapid_keys --subject mailto:admin@example.com
WEB_PUSH_ENABLED=False
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_TTL_SECONDS=300

# ========================================
# 验证码配置
# ========================================
# Cloudflare Turnstile
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=True

# 验证码后端
CAPTCHA_BACKEND=auto  # auto | turnstile | simple

# ========================================
# 文件存储配置
# ========================================
# 默认存储后端（留空使用本地文件系统）
DEFAULT_FILE_STORAGE_BACKEND=

# 媒体文件配置
MEDIA_URL=/uploads/
MEDIA_ROOT=knowledge_project/uploads
BACKUP_DIR=backups

# ========================================
# Vite 开发模式
# ========================================
VITE_DEV_MODE=False  # 开发时设置为 True 启用热重载

# ========================================
# 代理配置（可选）
# ========================================
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
USE_X_FORWARDED_HOST=True  # 使用反向代理时设置为 True
USE_X_FORWARDED_PORT=True  # 使用反向代理时设置为 True
