[Unit]
Description=Team Project database and media backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/Team_Project
EnvironmentFile=/opt/Team_Project/.env
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/opt/Team_Project/.venv/bin/python manage.py run_backup --include-media --retention-days 30
